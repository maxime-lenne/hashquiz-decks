{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/host",
      "destination": "/host/index.html"
    },
    {
      "source": "/host/(.*)",
      "destination": "/host/$1"
    },
    {
      "source": "/((?!host/|host$).*)",
      "destination": "/$1"
    }
  ]
}
