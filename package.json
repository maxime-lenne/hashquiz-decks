{
  "name": "hashquiz-decks",
  "version": "0.0.0",
  "description": "Demo of a HashQuiz decks repository: a Markdown quiz played live, deployed on Vercel with Supabase Realtime",
  "keywords": ["hashquiz", "quiz", "kahoot-alternative", "markdown", "vercel", "supabase"],
  "homepage": "https://github.com/maxime-lenne/hashquiz-decks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxime-lenne/hashquiz-decks.git"
  },
  "bugs": "https://github.com/maxime-lenne/hashquiz-decks/issues",
  "author": "Maxime Lenne",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "check": "for f in decks/*/index.quizv.md; do hashquiz check \"$f\" || exit 1; done",
    "dev": "hashquiz dev",
    "build": "hashquiz build decks --out dist"
  },
  "devDependencies": {
    "hashquiz": "^1.0.0-beta.3"
  }
}
