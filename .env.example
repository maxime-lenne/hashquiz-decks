# Settings read by `hashquiz build`. Bun loads `.env` automatically.
# Without them the build uses the local transport (`hashquiz dev` only).
# On Vercel, set the same variables in Project Settings → Environment Variables.

HASHQUIZ_TRANSPORT=supabase
HASHQUIZ_SUPABASE_URL=https://<project-ref>.supabase.co
HASHQUIZ_SUPABASE_ANON_KEY=<anon public key>

# Optional, for search engines and link previews:
# HASHQUIZ_SITE_URL=https://<your-domain>
# HASHQUIZ_LANG=fr
# HASHQUIZ_INDEXABLE=true
# Public quiz pages under /quiz/ (they show the answers):
# HASHQUIZ_CATALOG=true
